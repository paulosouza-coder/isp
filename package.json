{
  "name": "isp-sprint",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @isp/api db:generate",
    "db:migrate": "pnpm --filter @isp/api db:migrate",
    "db:seed": "pnpm --filter @isp/api db:seed",
    "db:reset": "pnpm --filter @isp/api db:reset",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.6.3"
  }
}
